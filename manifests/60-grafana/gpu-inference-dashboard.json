{
  "uid": "gpu-inference-obs",
  "title": "GPU inference: which pod is in trouble?",
  "links": [
    {
      "type": "link",
      "title": "Deep dive (all panels)",
      "url": "/d/gpu-inference-deep",
      "icon": "dashboard"
    }
  ],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "gpu",
    "inference",
    "vllm",
    "dcgm",
    "fluent-bit",
    "otel"
  ],
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "load hits",
        "target": {
          "type": "tags",
          "tags": [
            "load"
          ],
          "matchAny": true,
          "limit": 20
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\", pod=~\"vllm-(constrained|overprov).*\"} == 1)",
          "refId": "pod"
        },
        "regex": "/pod=\"([^\"]+)\"/",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Same model, same GPU. Which pod is in trouble?",
      "description": "KV cache is the real 'GPU full' for an LLM server. With traffic: over 90% = memory-constrained, under 30% = over-provisioned. No traffic = OK.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{pod_name}}",
          "expr": "(max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-constrained.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\") and on(pod_name) label_replace(sum by (pod) (rate(vllm:request_success_total{pod=~\"$pod\"}[3m])) > 0, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) or ((max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-constrained.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) * 0 - 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "legendFormat": "{{pod_name}}",
          "expr": "(max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-overprov.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\") and on(pod_name) label_replace(sum by (pod) (rate(vllm:request_success_total{pod=~\"$pod\"}[3m])) > 0, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) or ((max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-overprov.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) * 0 - 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "Waiting for the first log line",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 90,
                "to": 1000,
                "result": {
                  "text": "MEMORY-CONSTRAINED",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 30,
                "to": 90,
                "result": {
                  "text": "BUSY",
                  "color": "orange",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 30,
                "result": {
                  "text": "OVER-PROVISIONED",
                  "color": "blue",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": {
          "titleSize": 30,
          "valueSize": 52
        },
        "orientation": "vertical",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU memory in use  \u00b7  GPU exporter (DCGM)  \u00b7  the number we page on",
      "description": "vLLM reserves its GPU memory at start-up, so this never moves under load. The pod in trouble even uses less.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 12
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED{exported_pod=~\"$pod\", exported_pod=~\"vllm-constrained.*\"}",
          "legendFormat": "{{exported_pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "DCGM_FI_DEV_FB_USED{exported_pod=~\"$pod\", exported_pod=~\"vllm-overprov.*\"}",
          "legendFormat": "{{exported_pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "noValue": "No GPU data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*constrained.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*overprov.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true,
        "text": {
          "titleSize": 18,
          "valueSize": 64
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "How full the server really is  \u00b7  KV cache %  \u00b7  from its own log line",
      "description": "The model server's working memory. Read from the vLLM log line by Fluent Bit + a 15-line Lua filter. 100% = full, new requests wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 12
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-constrained.*\"} and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")",
          "legendFormat": "{{pod_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-overprov.*\"} and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")",
          "legendFormat": "{{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No traffic",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "max": 100,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*constrained.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*overprov.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true,
        "text": {
          "titleSize": 18,
          "valueSize": 64
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "How long a request takes  \u00b7  average  \u00b7  what the user feels",
      "description": "End-to-end request time measured by vLLM itself (/metrics): sum / count over the last 2 min. Matches the trace durations below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 12
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (pod) (rate(vllm:e2e_request_latency_seconds_sum{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) / sum by (pod) (rate(vllm:e2e_request_latency_seconds_count{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) >= 0) or (sum by (pod) (rate(vllm:e2e_request_latency_seconds_count{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) * 0)",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (pod) (rate(vllm:e2e_request_latency_seconds_sum{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) / sum by (pod) (rate(vllm:e2e_request_latency_seconds_count{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) >= 0) or (sum by (pod) (rate(vllm:e2e_request_latency_seconds_count{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) * 0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No traffic",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*constrained.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*overprov.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true,
        "text": {
          "titleSize": 18,
          "valueSize": 64
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "The slowest requests on the red pod (traces)  \u00b7  click one",
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "description": "Jaeger search for this service. Click a Trace ID: the trace opens, and each span has links to this pod's GPU memory and KV cache.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "refId": "A",
          "queryType": "search",
          "service": "vllm-constrained",
          "operation": "llm_request",
          "limit": 40
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Duration",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 6
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Trace name": true,
              "Start time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "unit",
                "value": "\u00b5s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000000
                    },
                    {
                      "color": "red",
                      "value": 3000000
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}