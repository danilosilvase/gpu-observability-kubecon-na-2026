            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "DCGM_FI_DEV_FB_USED{exported_pod=~\"$pod\", exported_pod=~\"vllm-overprov.*\"}",
          "legendFormat": "{{exported_pod}}"
        }
      ],
      "fieldConfig": {
