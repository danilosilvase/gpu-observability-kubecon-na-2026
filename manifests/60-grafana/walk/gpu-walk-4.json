{
  "uid": "gpu-walk-4",
  "title": "4 \u00b7 Which one was set wrong?",
  "links": [
    {
      "type": "link",
      "title": "Next: 1 GPU",
      "url": "/d/gpu-walk-1",
      "icon": "dashboard"
    }
  ],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "tags": [
    "gpu",
    "inference",
    "vllm",
    "dcgm",
    "fluent-bit",
    "otel"
  ],
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "load hits",
        "target": {
          "type": "tags",
          "tags": [
            "load"
          ],
          "matchAny": true,
          "limit": 20
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\", pod=~\"vllm-(constrained|overprov).*\"} == 1)",
          "refId": "pod"
        },
        "regex": "/pod=\"([^\"]+)\"/",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;justify-content:space-between;align-items:center;font-size:20px;line-height:1.2;letter-spacing:0.5px\"><span><span style=\"color:#a0a0a0\">1 GPU</span><span style=\"color:#555\"> &rsaquo; </span><span style=\"color:#a0a0a0\">2 Log</span><span style=\"color:#555\"> &rsaquo; </span><span style=\"color:#a0a0a0\">3 Trace</span><span style=\"color:#555\"> &rsaquo; </span><span style=\"color:#ffffff;font-weight:700;border-bottom:4px solid #ff9830;padding-bottom:2px\">4 Answer</span></span></div><div style=\"font-size:40px;line-height:1.2;font-weight:700;color:#ffffff;margin-top:0;padding-bottom:6px\">Is 8% too low? Is 90% too high?</div>"
      }
    },
    {
      "id": 101,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 9,
        "h": 20
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"font-size:16px;color:#9a9a9a;margin-bottom:6px\">rule of thumb (ours, not vLLM's)</div><pre style=\"font-size:23px;line-height:1.5;background:#111217;border:1px solid #2c3235;padding:14px 16px;border-radius:8px;white-space:pre-wrap;margin:0\"><span style=\"display:block\">peak KV cache under real traffic</span><span style=\"display:block;background:#4d3d00;color:#ffd666;font-weight:700;margin:0 -16px;padding:0 16px\">  > 90%  memory-constrained</span><span style=\"display:block;background:#4d3d00;color:#ffd666;font-weight:700;margin:0 -16px;padding:0 16px\">  < 40%  over-provisioned</span></pre><div style=\"font-size:21px;color:#d8d9da;margin-top:14px;line-height:1.4\">Watch the server's own signal, per pod. The GPU memory chart cannot answer this.</div>"
      }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Verdict per pod  \u00b7  peak KV cache while it has traffic",
      "description": "KV cache is the real 'GPU full' for an LLM server. With traffic: over 90% = memory-constrained, under 40% = over-provisioned (our rule of thumb). No traffic = OK.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 3,
        "w": 15,
        "h": 7
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{pod_name}}",
          "expr": "(max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-constrained.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\") and on(pod_name) label_replace(sum by (pod) (rate(vllm:request_success_total{pod=~\"$pod\"}[3m])) > 0, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) or ((max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-constrained.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) * 0 - 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "legendFormat": "{{pod_name}}",
          "expr": "(max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-overprov.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\") and on(pod_name) label_replace(sum by (pod) (rate(vllm:request_success_total{pod=~\"$pod\"}[3m])) > 0, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) or ((max by (pod_name) (max_over_time(vllm_log_kv_cache_usage_pct{pod_name=~\"$pod\", pod_name=~\"vllm-overprov.*\"}[3m])) and on(pod_name) label_replace(kube_pod_status_phase{namespace=\"inference\", phase=\"Running\"} == 1, \"pod_name\", \"$1\", \"pod\", \"(.*)\")) * 0 - 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "Waiting for the first log line",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 90,
                "to": 1000,
                "result": {
                  "text": "MEMORY-CONSTRAINED",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 40,
                "to": 90,
                "result": {
                  "text": "BUSY",
                  "color": "orange",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 40,
                "result": {
                  "text": "OVER-PROVISIONED",
                  "color": "blue",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": {
          "titleSize": 30,
          "valueSize": 52
        },
        "orientation": "vertical",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 41,
      "type": "stat",
      "title": "GPU memory  \u00b7  DCGM",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
