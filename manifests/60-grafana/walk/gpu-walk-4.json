            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED{exported_pod=~\"$pod\", exported_pod=~\"vllm-constrained.*\"}",
          "legendFormat": "{{exported_pod}}"
        },
