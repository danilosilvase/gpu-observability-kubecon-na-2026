    {
      "id": 43,
      "type": "stat",
      "title": "Time to first token",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 10,
        "w": 5,
        "h": 13
      },
      "interval": "5s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (pod) (rate(vllm:time_to_first_token_seconds_sum{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) / sum by (pod) (rate(vllm:time_to_first_token_seconds_count{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) >= 0) or (sum by (pod) (rate(vllm:time_to_first_token_seconds_count{pod=~\"$pod\", pod=~\"vllm-constrained.*\"}[2m])) * 0)",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (pod) (rate(vllm:time_to_first_token_seconds_sum{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) / sum by (pod) (rate(vllm:time_to_first_token_seconds_count{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) >= 0) or (sum by (pod) (rate(vllm:time_to_first_token_seconds_count{pod=~\"$pod\", pod=~\"vllm-overprov.*\"}[2m])) * 0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 2,
          "mappings": [
