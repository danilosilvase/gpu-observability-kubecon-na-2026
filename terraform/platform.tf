############################################
# kube-prometheus-stack (Prometheus + Grafana + Operator/CRDs)
############################################
resource "helm_release" "kps" {
  name             = "kube-prometheus-stack"
  repository       = "https://prometheus-community.github.io/helm-charts"
  chart            = "kube-prometheus-stack"
  version          = "65.5.0"
  namespace        = "observability"
  create_namespace = true
  timeout          = 900
  wait             = true

  values = [yamlencode({
    prometheus = {
      prometheusSpec = {
        # discover ALL ServiceMonitors regardless of helm release label
        serviceMonitorSelectorNilUsesHelmValues = false
        podMonitorSelectorNilUsesHelmValues     = false
        retention                               = "6h"
      }
    }
    grafana = {
      adminPassword = var.grafana_admin_password
      sidecar = {
        dashboards = {
          enabled         = true
          searchNamespace = "ALL"
          label           = "grafana_dashboard"
        }
      }
    }
    # Auto Mode note: kube-state-metrics/node-exporter schedule on managed nodes
    nodeExporter = { enabled = true }
  })]

  depends_on = [module.eks]
}

# Grafana dashboard delivered as a labelled ConfigMap (sidecar auto-imports)
resource "kubernetes_config_map_v1" "dashboard" {
  metadata {
    name      = "gpu-inference-dashboard"
    namespace = "observability"
    labels    = { grafana_dashboard = "1" }
  }
  data = { # single-screen dashboard + deep dive, both generated by build_dashboard.py
    "gpu-inference-dashboard.json" = file("${local.m}/60-grafana/gpu-inference-dashboard.json")
    "gpu-inference-deep-dive.json" = file("${local.m}/60-grafana/gpu-inference-deep-dive.json")
  }
  depends_on = [helm_release.kps]
}

# The 4-screen demo walkthrough (DEMO.md), generated by build_walkthrough.py.
# Terraform owns this ConfigMap; manifests/deploy.sh creates the same one for clusters without Terraform (use one or the other).
resource "kubernetes_config_map_v1" "walkthrough" {
  metadata {
    name      = "gpu-walkthrough-dashboards"
    namespace = "observability"
    labels    = { grafana_dashboard = "1" }
  }
  data       = { for f in fileset("${local.m}/60-grafana/walk", "*.json") : f => file("${local.m}/60-grafana/walk/${f}") }
  depends_on = [helm_release.kps]
}

############################################
# Workload manifests via kubectl provider
############################################
# Single source of truth: the same plain YAML in manifests/ that deploy.sh applies.
locals { m = "${path.module}/../manifests" }

data "kubectl_file_documents" "namespaces" { content = file("${local.m}/00-cluster/namespaces.yaml") }
data "kubectl_file_documents" "nodepool" { content = file("${local.m}/00-cluster/nodepool-gpu.yaml") }
data "kubectl_file_documents" "workloads" {
  content = join("\n---\n", [
    file("${local.m}/10-gpu-metrics/dcgm-exporter.yaml"),
    file("${local.m}/20-vllm/vllm.yaml"),
    file("${local.m}/30-logs/fluent-bit.yaml"),
    file("${local.m}/40-traces/otel-collector.yaml"),
    file("${local.m}/40-traces/jaeger.yaml"),
  ])
}
data "kubectl_file_documents" "servicemonitors" { content = file("${local.m}/50-prometheus/servicemonitors.yaml") }
data "kubectl_file_documents" "grafana_ds" { content = file("${local.m}/60-grafana/jaeger-datasource.yaml") }

resource "kubectl_manifest" "namespaces" {
  for_each          = data.kubectl_file_documents.namespaces.manifests
  yaml_body         = each.value
  server_side_apply = true
  depends_on        = [module.eks]
}

resource "kubectl_manifest" "nodepool" {
  for_each          = data.kubectl_file_documents.nodepool.manifests
  yaml_body         = each.value
  server_side_apply = true
  depends_on        = [module.eks]
}

resource "kubectl_manifest" "workloads" {
  for_each          = data.kubectl_file_documents.workloads.manifests
  yaml_body         = each.value
  server_side_apply = true
  depends_on        = [kubectl_manifest.namespaces, kubectl_manifest.nodepool]
}

resource "kubectl_manifest" "servicemonitors" {
  for_each          = data.kubectl_file_documents.servicemonitors.manifests
  yaml_body         = each.value
  server_side_apply = true
  depends_on        = [helm_release.kps, kubectl_manifest.workloads]
}

# Jaeger datasource for Grafana (sidecar auto-loads ConfigMaps labelled grafana_datasource=1).
# Carries the trace -> GPU metrics links, so a slow span opens that pod's DCGM and KV cache.
resource "kubectl_manifest" "grafana_ds" {
  for_each          = data.kubectl_file_documents.grafana_ds.manifests
  yaml_body         = each.value
  server_side_apply = true
  depends_on        = [helm_release.kps]
}
